{
  "manifest_version": 3,
  "name": "DentAI — asistente de voz",
  "version": "0.3.0",
  "description": "Dicta, revisa y completa formularios clínicos sin acceder a credenciales.",
  "minimum_chrome_version": "139",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "https://*.google.com.pe/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Abrir DentAI"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.google.com/*",
        "https://*.google.com.pe/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "page-voice-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.google.com/*",
        "https://*.google.com.pe/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start"
    }
  ]
}
